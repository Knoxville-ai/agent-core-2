# ---------------------------------------------------------------------------
# agent-core (openclaw vessel) — environment contract
# ---------------------------------------------------------------------------
# Required vars are injected by the knoxville-ai-console during provisioning
# (src/lib/provisioning.ts:buildAgentEnvVars). This file documents the full
# surface so the container can be exercised locally.

# ── Agent identity (set by console) ────────────────────────────────────────
AGENT_UID=                # 16-char lowercase hex (sha256(TELEGRAM_BOT_TOKEN)[:16])
AGENT_ORG=                # org slug, matches public.agents.org_id
AGENT_ROLE=generic        # 'generic' for openclaw vessel agents

# ── Shim → console auth ────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=      # HS256 secret used to verify caller bearer JWTs
MESSAGING_ENABLED=true    # set by console when SUPABASE_JWT_SECRET is present

# ── Shim → openclaw auth ───────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=   # random bearer; shim uses it to talk to local gateway

# ── Supabase Storage (workspace sync + manifest) ───────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Model selection (provisioning writes this into openclaw.json) ──────────
LLM_PROVIDER=anthropic    # 'anthropic' | 'openai' | 'ollama' | etc.
LLM_MODEL=claude-opus-4-7 # full model id in the provider's namespace
LLM_API_KEY=              # optional: forwarded to openclaw as the provider key

# Optional provider endpoint override → openclaw.json
# models.providers.<LLM_PROVIDER>.baseURL. Two ways to save on the API bill:
#   1. External cheap OpenAI-compatible endpoint (recommended). Set to the
#      provider's /v1 URL and put its key in LLM_API_KEY, e.g.:
#        Groq:     LLM_PROVIDER=openai LLM_BASE_URL=https://api.groq.com/openai/v1
#        DeepSeek: LLM_PROVIDER=openai LLM_BASE_URL=https://api.deepseek.com/v1
#        Your own Ollama box: LLM_BASE_URL=http://<host>:11434/v1
#   2. In-container Ollama (LLM_PROVIDER=ollama): LEAVE THIS UNSET — the
#      container starts a loopback Ollama server and defaults the baseURL to it,
#      and pulls LLM_MODEL's weights on first boot. Needs a Railway plan with
#      enough RAM (small 7-8B models only; CPU inference is slow).
LLM_BASE_URL=

# ── Platform MCP (agent's outbound channel for A2A discovery + bundle) ─────
# When set, the openclaw agent is configured with an MCP server pointing at
# the knoxville platform so it can (a) discover and talk to other agents
# and (b) fetch its capability bundle at boot via `get_my_bundle`.
PLATFORM_MCP_URL=                  # e.g. https://knoxville.ai/api/mcp
PLATFORM_API_TOKEN=                # per-agent bearer (knox_agent_*)

# ── Long-running tasks (console migration 0047) ────────────────────────────
# The platform POSTs /api/v1/tasks; the shim 202s immediately and runs the work
# detached, reporting progress + the result back over the task callback API. A
# task is NOT bound to any request, so it may run for an hour or more.
#
# AGENT_MAX_CONCURRENT_TASKS governs ORDINARY tasks. DELEGATED tasks (the ones
# carrying credentials another agent shared) always run one at a time in their
# own lane, regardless of this value — the exec shim's credential lookup is
# fail-closed when two delegated turns overlap, and an hour-long task would make
# that overlap routine. See src/shim/task-runner.ts for the full reasoning.
#
# AGENT_TASK_HEARTBEAT_SECONDS must stay well under the console's
# TASK_HEARTBEAT_GRACE_SECONDS (default 300) or healthy tasks get reaped as dead.
AGENT_MAX_CONCURRENT_TASKS=3
AGENT_MAX_QUEUED_TASKS=50
AGENT_TASK_HEARTBEAT_SECONDS=30

# ── Ports (defaults are fine for Railway) ──────────────────────────────────
AGENT_HTTP_PORT=8080
OPENCLAW_GATEWAY_PORT=18789

# ── Optional pass-throughs ─────────────────────────────────────────────────
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# ── openclaw runtime tuning (optional) ─────────────────────────────────────
# Autonomous heartbeat cadence (openclaw.json agents.defaults.heartbeat.every).
# openclaw runs a periodic "heartbeat" turn on the main agent by default at 30m
# — a FULL model inference (whole system prompt + every tool schema, for a tiny
# "nothing to do" ack delivered nowhere) that fires around the clock even while
# the agent is idle. For a reactive vessel that is pure cost: an idle agent bills
# ~one full input every 30 minutes overnight and on weekends. It is therefore
# DISABLED by default. Leave unset (or "off"/"0"/"none") to keep it off; set an
# openclaw duration ("8h", "2h", "30m") ONLY for a genuinely autonomous agent
# that must wake itself up.
OPENCLAW_HEARTBEAT_EVERY=
