# ---------------------------------------------------------------------------
# agent-core (openclaw vessel) — environment contract
# ---------------------------------------------------------------------------
# Required vars are injected by the knoxville-ai-console during provisioning
# (src/lib/provisioning.ts:buildAgentEnvVars). This file documents the full
# surface so the container can be exercised locally.

# ── Agent identity (set by console) ────────────────────────────────────────
AGENT_UID=                # 16-char lowercase hex (sha256(TELEGRAM_BOT_TOKEN)[:16])
AGENT_ORG=                # org slug, matches public.agents.org_id
AGENT_ROLE=generic        # 'generic' for openclaw vessel agents

# ── Shim → console auth ────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=      # HS256 secret used to verify caller bearer JWTs
MESSAGING_ENABLED=true    # set by console when SUPABASE_JWT_SECRET is present

# ── Shim → openclaw auth ───────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=   # random bearer; shim uses it to talk to local gateway

# ── Supabase Storage (workspace sync + manifest) ───────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Model selection (provisioning writes this into openclaw.json) ──────────
LLM_PROVIDER=anthropic    # 'anthropic' | 'openai' | 'local' | etc.
LLM_MODEL=claude-opus-4-7 # full model id in the provider's namespace
LLM_API_KEY=              # optional: forwarded to openclaw as the provider key

# ── Platform MCP (agent's outbound channel for A2A discovery + bundle) ─────
# When set, the openclaw agent is configured with an MCP server pointing at
# the knoxville platform so it can (a) discover and talk to other agents
# and (b) fetch its capability bundle at boot via `get_my_bundle`.
PLATFORM_MCP_URL=                  # e.g. https://knoxville.ai/api/mcp
PLATFORM_API_TOKEN=                # per-agent bearer (knox_agent_*)

# ── Ports (defaults are fine for Railway) ──────────────────────────────────
AGENT_HTTP_PORT=8080
OPENCLAW_GATEWAY_PORT=18789

# ── Optional pass-throughs ─────────────────────────────────────────────────
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=
