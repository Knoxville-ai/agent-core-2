# ---------------------------------------------------------------------------
# agent-core (openclaw vessel) — environment contract
# ---------------------------------------------------------------------------
# Required vars are injected by the knoxville-ai-console during provisioning
# (src/lib/provisioning.ts:buildAgentEnvVars). This file documents the full
# surface so the container can be exercised locally.

# ── Agent identity (set by console) ────────────────────────────────────────
AGENT_UID=                # 16-char lowercase hex (sha256(TELEGRAM_BOT_TOKEN)[:16])
AGENT_ORG=                # org slug, matches public.agents.org_id
AGENT_ROLE=generic        # 'generic' for openclaw vessel agents

# ── Shim → console auth ────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=      # HS256 secret used to verify caller bearer JWTs
MESSAGING_ENABLED=true    # set by console when SUPABASE_JWT_SECRET is present

# ── Shim → openclaw auth ───────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=   # random bearer; shim uses it to talk to local gateway

# ── Supabase Storage (workspace sync + manifest) ───────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Model selection (provisioning writes this into openclaw.json) ──────────
# The live fleet runs on OpenRouter (one key, many models). `anthropic`,
# `openai`, `ollama`, etc. are also supported — see LLM_BASE_URL below.
LLM_PROVIDER=openrouter        # 'openrouter' | 'anthropic' | 'openai' | 'ollama' | …
LLM_MODEL=qwen/qwen3.7-plus    # full model id in the provider's namespace
LLM_API_KEY=                   # forwarded to openclaw as the provider key

# Optional provider endpoint override → openclaw.json
# models.providers.<LLM_PROVIDER>.baseURL. Two ways to save on the API bill:
#   1. External cheap OpenAI-compatible endpoint (recommended). Set to the
#      provider's /v1 URL and put its key in LLM_API_KEY, e.g.:
#        Groq:     LLM_PROVIDER=openai LLM_BASE_URL=https://api.groq.com/openai/v1
#        DeepSeek: LLM_PROVIDER=openai LLM_BASE_URL=https://api.deepseek.com/v1
#        Your own Ollama box: LLM_BASE_URL=http://<host>:11434/v1
#   2. In-container Ollama (LLM_PROVIDER=ollama): LEAVE THIS UNSET — the
#      container starts a loopback Ollama server and defaults the baseURL to it,
#      and pulls LLM_MODEL's weights on first boot. Needs a Railway plan with
#      enough RAM (small 7-8B models only; CPU inference is slow).
LLM_BASE_URL=

# ── Platform MCP (agent's outbound channel for A2A discovery + bundle) ─────
# When set, the openclaw agent is configured with an MCP server pointing at
# the knoxville platform so it can (a) discover and talk to other agents
# and (b) fetch its capability bundle at boot via `get_my_bundle`.
PLATFORM_MCP_URL=                  # e.g. https://knoxville.ai/api/mcp
PLATFORM_API_TOKEN=                # per-agent bearer (knox_agent_*)

# ── Long-running tasks (console migration 0047) ────────────────────────────
# The platform POSTs /api/v1/tasks; the shim 202s immediately and runs the work
# detached, reporting progress + the result back over the task callback API. A
# task is NOT bound to any request, so it may run for an hour or more.
#
# AGENT_MAX_CONCURRENT_TASKS is the real throughput knob AND the real cost knob:
# every lane is a concurrent model stream. It governs delegated and ordinary
# tasks alike. An SME agent whose whole job is accepting delegated work should
# raise this well above the default; a general-purpose agent rarely needs to.
#
# AGENT_DELEGATED_TASK_MODE controls how credential-carrying tasks share the
# vessel:
#   parallel (default) — they run like any other task. Safe because the openclaw
#     before_tool_call plugin injects credentials keyed by ctx.sessionKey, so
#     concurrent tasks never share a lookup key and never see each other's
#     secrets.
#   serial — at most ONE credential-carrying task at a time. The fallback for a
#     deployment where that plugin path is unavailable, leaving only the exec
#     shim, which openclaw gives no session key and which therefore fails closed
#     whenever two delegated turns overlap.
# Flip to serial if skills start reporting missing credentials under load and the
# vessel logs "[delegated-credentials] N delegated turns live at once".
#
# AGENT_TASK_HEARTBEAT_SECONDS must stay well under the console's
# TASK_HEARTBEAT_GRACE_SECONDS (default 300) or healthy tasks get reaped as dead.
AGENT_MAX_CONCURRENT_TASKS=3
AGENT_DELEGATED_TASK_MODE=parallel
AGENT_MAX_QUEUED_TASKS=50
AGENT_TASK_HEARTBEAT_SECONDS=30

# ── Ports (defaults are fine for Railway) ──────────────────────────────────
AGENT_HTTP_PORT=8080
OPENCLAW_GATEWAY_PORT=18789

# ── OpenRouter cost tracking ───────────────────────────────────────────────
# OpenRouter returns the REAL, discount-inclusive charge for every call in the
# response's `usage.cost`, but openclaw discards it before the shim can read it.
# So the shim runs a transparent loopback proxy in front of OpenRouter: it
# forwards each call byte-for-byte and reads `usage.cost` off the response, then
# stores the actual per-turn cost on the message. The console uses that instead
# of its token×rate estimate (which ignores discounts). Only active when
# LLM_PROVIDER=openrouter — there is nothing to intercept for other providers.
#
# Fail-open: if the proxy can't bind at boot it is skipped and the vessel runs
# normally against OpenRouter directly, just without actual-cost capture. Set to
# false to disable interception entirely (kill switch).
OPENROUTER_COST_TRACKING=true
# Loopback port the cost proxy binds (openclaw's OpenRouter baseUrl points here).
OPENROUTER_COST_PROXY_PORT=18790
# Where the proxy forwards to. Defaults to the public OpenRouter API; set only to
# pin a regional/gateway host (otherwise LLM_BASE_URL, then the default, is used).
OPENROUTER_UPSTREAM_URL=

# ── Optional pass-throughs ─────────────────────────────────────────────────
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# ── openclaw runtime tuning (optional) ─────────────────────────────────────
# Autonomous heartbeat cadence (openclaw.json agents.defaults.heartbeat.every).
# openclaw runs a periodic "heartbeat" turn on the main agent by default at 30m
# — a FULL model inference (whole system prompt + every tool schema, for a tiny
# "nothing to do" ack delivered nowhere) that fires around the clock even while
# the agent is idle. For a reactive vessel that is pure cost: an idle agent bills
# ~one full input every 30 minutes overnight and on weekends. It is therefore
# DISABLED by default. Leave unset (or "off"/"0"/"none") to keep it off; set an
# openclaw duration ("8h", "2h", "30m") ONLY for a genuinely autonomous agent
# that must wake itself up.
OPENCLAW_HEARTBEAT_EVERY=

# ── Prompt-cache tuning ──────────────────────────────────────────────────────
#
# Where the per-turn `# DYNAMIC CONTEXT` system block goes in the outgoing
# message array: "tail" (default) or "lead".
#
# Prompt caches match token-by-token from the FRONT of the prompt. That block is
# rebuilt every turn from recent memories, caller context ordered by
# last_interaction_at, and a 30s-TTL knowledge index — so at index 0 a single
# `remember` call during one turn changes byte 0 of the next and invalidates the
# ENTIRE cached prefix. Appending it keeps the stable history cacheable.
#
# Leave unset. Set to "lead" only to roll back to the historical prepend
# behaviour without a code release.
AGENT_DYNAMIC_CONTEXT_POSITION=

# Prompt-cache retention hint (openclaw.json agents.defaults.params.cacheRetention):
#   short — provider default TTL (Anthropic: 5m)
#   long  — extended TTL where the endpoint supports it (Anthropic: 1h)
#   none  — do not request cache breakpoints at all
#
# SCOPE: openclaw emits `cache_control` breakpoints ONLY on its
# `anthropic-messages` transport. On the `openai-completions` path this vessel
# uses for OpenRouter and OpenAI, the value is inert — those providers either
# cache implicitly (OpenAI) or need provider-side support the pinned openclaw
# does not send. Left unset so nothing changes until an operator opts in.
LLM_CACHE_RETENTION=

# ── Tool-block cost control ──────────────────────────────────────────────────
#
# An agent bound to a large MCP (e.g. Odoo, ~127 tools) ships those tool schemas
# — tens of thousands of tokens — on EVERY model call. Two levers cut that.

# 1) Hard allow/deny (openclaw tools.{allow,deny,alsoAllow}). The surgical cut
#    for single-purpose agents. Comma/space/newline-separated tool ids, groups
#    (`group:openclaw`), or globs (`odoo_production__*`).
#
#    openclaw policy semantics (footguns — read before setting allow):
#      • DENY WINS: a denied tool stays denied even if also allowed.
#      • EMPTY allow = fail-open (all tools, minus deny). Only a non-empty allow
#        restricts.
#      • A non-empty allow is COMPLETE: everything not matched is denied — so it
#        MUST include the tools the agent needs to function (core
#        `group:openclaw group:plugins`, platform `knoxville_platform__*`) or the
#        agent bricks.
#      • allow and alsoAllow are MUTUALLY EXCLUSIVE (the vessel refuses to boot
#        if both are set). Use `allow` alone as a complete list, OR
#        `profile` + `alsoAllow` to extend a base profile.
#
#    Prefer DENY for coarse cuts ("this agent needs zero Odoo"):
#      OPENCLAW_TOOLS_DENY=odoo_production__*
#    Reserve ALLOW for deliberate single-purpose lockdown, e.g.:
#      OPENCLAW_TOOLS_ALLOW=group:openclaw group:plugins knoxville_platform__* odoo_production__sales_confirm_order
OPENCLAW_TOOLS_ALLOW=
OPENCLAW_TOOLS_ALSO_ALLOW=

# 2) Deferred discovery (openclaw tools.toolSearch): off | tools | code.
#    Pulls the bulk of tool schemas OUT of the prompt; the model searches to load
#    a tool on demand. Works on the openai-completions transport (unlike prompt
#    caching). OFF by default: openclaw's deferral is ALL-OR-NOTHING (it hides
#    EVERY functional tool, including exec and the platform MCP, behind the search
#    tools) — a real behavioral risk on weaker models that adds round trips. Turn
#    on for ONE agent, eval, then widen. `code` needs node --permission (absent in
#    this image) and silently falls back to `tools`, so prefer `tools`.
OPENCLAW_TOOL_SEARCH=off
