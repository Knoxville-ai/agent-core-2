#!/bin/sh
# git credential helper for https://github.com (see the Dockerfile's
# `git config --system` lines; no other host ever reaches it).
#
# Two sources, in order:
#
# 1. KNOX_GITHUB_TOKEN — a static token bound to the agent as an org
#    credential under that env key on its Credentials tab (the original
#    setup). It must NOT be GITHUB_TOKEN or GH_TOKEN: openclaw strips both
#    from every exec command's environment (they are in its host-env security
#    policy's blockedOverrideOnlyKeys, which also apply to inherited env), so
#    a helper reading them only ever sees an empty value.
#
# 2. The console's GitHub connector. With no static token, git's request is
#    forwarded to <platform MCP URL>/github/git-credential with the agent's
#    platform token. The console answers with a one-hour GitHub App token for
#    exactly the requested repository, at the access the agent was granted on
#    its MCP servers tab — or with nothing for a repository it wasn't granted.
#    credential.useHttpPath (set in the Dockerfile) makes git send the
#    repository path the console needs.
#
#    The platform URL and token are not in exec commands' environment (the
#    shim withholds platform variables from the gateway; see
#    src/openclaw/child-env.ts), so they are read from the platform MCP entry
#    of openclaw.json, the file the gateway itself reads them from. A
#    PLATFORM_MCP_URL / PLATFORM_API_TOKEN pair in the environment (e.g. git
#    run by hand in the container) still takes precedence. The token is handed
#    to curl on stdin (-K -), never on a command line.
#
# Either way `git clone/push https://github.com/...` just works and the token
# never lands in a remote URL or .git/config. With neither source, print
# nothing: git falls through to its normal "no credentials" failure instead of
# prompting (there is no TTY to prompt on).

[ "$1" = "get" ] || exit 0

# git's request: protocol=https, host=github.com, path=owner/name.git
request=$(cat)

if [ -n "$KNOX_GITHUB_TOKEN" ]; then
  echo "username=x-access-token"
  echo "password=$KNOX_GITHUB_TOKEN"
  exit 0
fi

url="$PLATFORM_MCP_URL"
token="$PLATFORM_API_TOKEN"
if [ -z "$url" ] || [ -z "$token" ]; then
  cfg="${OPENCLAW_CONFIG_PATH:-${OPENCLAW_STATE_DIR:-$HOME/.openclaw}/openclaw.json}"
  [ -r "$cfg" ] || exit 0
  pair=$(node -e '
    try {
      const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const s = (c.mcp && c.mcp.servers && c.mcp.servers.knoxville_platform) || {};
      const auth = String((s.headers && s.headers.Authorization) || "");
      const tok = auth.startsWith("Bearer ") ? auth.slice(7).trim() : "";
      if (typeof s.url === "string" && s.url && tok) process.stdout.write(s.url + "\n" + tok + "\n");
    } catch {}
  ' "$cfg" 2>/dev/null) || exit 0
  url=$(printf '%s\n' "$pair" | sed -n 1p)
  token=$(printf '%s\n' "$pair" | sed -n 2p)
fi
[ -n "$url" ] && [ -n "$token" ] || exit 0

printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -fsS --max-time 20 \
  -K - \
  -X POST \
  -H "Content-Type: text/plain" \
  --data-binary "$request
" \
  "${url%/}/github/git-credential" 2>/dev/null || exit 0
