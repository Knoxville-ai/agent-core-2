#!/bin/sh
# git credential helper: hands git the GitHub token from the container env.
#
# Wired up for https://github.com only (see the Dockerfile's `git config
# --system` line), so the token is never offered to any other host.
#
# The token comes from KNOX_GITHUB_TOKEN, which the console sets by binding an
# org credential to the agent on its Credentials tab under that env key. It
# must NOT be GITHUB_TOKEN or GH_TOKEN: openclaw strips both from every exec
# command's environment (they are in its host-env security policy's
# blockedOverrideOnlyKeys, which also apply to inherited env), so a helper
# reading them only ever sees an empty value. The GitHub MCP server can keep
# using ${GITHUB_TOKEN} in its headers: those are expanded by the gateway,
# not inside exec.
#
# With the token in place, `git clone/push https://github.com/...` just works
# and the token never lands in a remote URL or .git/config.
#
# No token set: print nothing, and git falls through to its normal "no
# credentials" failure instead of prompting (there is no TTY to prompt on).

[ "$1" = "get" ] || exit 0

token="$KNOX_GITHUB_TOKEN"
[ -n "$token" ] || exit 0

# Drain git's request on stdin before answering.
cat >/dev/null

echo "username=x-access-token"
echo "password=$token"
