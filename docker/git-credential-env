#!/bin/sh
# git credential helper for https://github.com (see the Dockerfile's
# `git config --system` lines; no other host ever reaches it).
#
# Two sources, in order:
#
# 1. KNOX_GITHUB_TOKEN — a static token bound to the agent as an org
#    credential under that env key on its Credentials tab (the original
#    setup). It must NOT be GITHUB_TOKEN or GH_TOKEN: openclaw strips both
#    from every exec command's environment (they are in its host-env security
#    policy's blockedOverrideOnlyKeys, which also apply to inherited env), so
#    a helper reading them only ever sees an empty value.
#
# 2. The console's GitHub connector. With no static token, and the agent's
#    platform credentials present (PLATFORM_MCP_URL / PLATFORM_API_TOKEN,
#    which openclaw leaves alone), git's request is forwarded to
#    ${PLATFORM_MCP_URL}/github/git-credential. The console answers with a
#    one-hour GitHub App token for exactly the requested repository, at the
#    access the agent was granted on its MCP servers tab — or with nothing
#    for a repository it wasn't granted. credential.useHttpPath (set in the
#    Dockerfile) makes git send the repository path the console needs.
#
# Either way `git clone/push https://github.com/...` just works and the token
# never lands in a remote URL or .git/config. With neither source, print
# nothing: git falls through to its normal "no credentials" failure instead of
# prompting (there is no TTY to prompt on).

[ "$1" = "get" ] || exit 0

# git's request: protocol=https, host=github.com, path=owner/name.git
request=$(cat)

if [ -n "$KNOX_GITHUB_TOKEN" ]; then
  echo "username=x-access-token"
  echo "password=$KNOX_GITHUB_TOKEN"
  exit 0
fi

[ -n "$PLATFORM_MCP_URL" ] && [ -n "$PLATFORM_API_TOKEN" ] || exit 0

printf '%s\n' "$request" | curl -fsS --max-time 20 \
  -X POST \
  -H "Authorization: Bearer $PLATFORM_API_TOKEN" \
  -H "Content-Type: text/plain" \
  --data-binary @- \
  "${PLATFORM_MCP_URL%/}/github/git-credential" 2>/dev/null || exit 0
